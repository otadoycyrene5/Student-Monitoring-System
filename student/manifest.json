{
  "manifest_version": 3,
  "name": "Classence Student",
  "version": "0.7.4",
  "description": "Classence student classes, sessions and consent-based Google Meet monitoring.",
  "key": "",
  "action": {
    "default_title": "Classence Student",
    "default_popup": "index.html"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://meet.google.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:* ws://127.0.0.1:*"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "js/background.js"
  }
}
